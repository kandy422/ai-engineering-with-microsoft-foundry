{
  "name": "course16-support-v1",
  "fields": [
    {
      "name": "id",
      "type": "Edm.String",
      "key": true,
      "filterable": true
    },
    {
      "name": "tenantId",
      "type": "Edm.String",
      "filterable": true
    },
    {
      "name": "customerScope",
      "type": "Edm.String",
      "filterable": true
    },
    {
      "name": "factKey",
      "type": "Edm.String",
      "filterable": true
    },
    {
      "name": "factValue",
      "type": "Edm.String",
      "filterable": true
    },
    {
      "name": "isActive",
      "type": "Edm.Boolean",
      "filterable": true
    },
    {
      "name": "content",
      "type": "Edm.String",
      "searchable": true,
      "retrievable": true
    },
    {
      "name": "answer",
      "type": "Edm.String",
      "searchable": true,
      "retrievable": true
    },
    {
      "name": "contentVector",
      "type": "Collection(Edm.Single)",
      "dimensions": 1536,
      "vectorSearchProfile": "policy-vector",
      "searchable": true,
      "retrievable": false
    }
  ],
  "semantic": {
    "configurations": [
      {
        "name": "policy-semantic",
        "prioritizedFields": {
          "prioritizedContentFields": [
            {
              "fieldName": "content"
            },
            {
              "fieldName": "answer"
            }
          ]
        }
      }
    ]
  },
  "vectorSearch": {
    "algorithms": [
      {
        "name": "cosine-hnsw",
        "kind": "hnsw",
        "hnswParameters": {
          "metric": "cosine"
        }
      }
    ],
    "profiles": [
      {
        "name": "policy-vector",
        "algorithm": "cosine-hnsw",
        "vectorizer": "course-embedding"
      }
    ],
    "vectorizers": [
      {
        "name": "course-embedding",
        "kind": "azureOpenAI",
        "azureOpenAIParameters": {
          "resourceUri": "${FOUNDRY_RESOURCE_URL}",
          "deploymentId": "${EMBEDDING_DEPLOYMENT}",
          "modelName": "text-embedding-3-small"
        }
      }
    ]
  }
}
