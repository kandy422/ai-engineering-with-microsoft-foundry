{
  "model": "course-chat",
  "messages": [
    {
      "role": "system",
      "content": "Extract the exact order ID from the customer text, or null if absent. Classify issueType as delivery, billing or review. Return one JSON object with orderId and issueType."
    },
    {
      "role": "user",
      "content": "My parcel is late."
    }
  ],
  "max_completion_tokens": 512,
  "reasoning_effort": "minimal",
  "response_format": {
    "type": "json_schema",
    "json_schema": {
      "name": "ticket",
      "strict": true,
      "schema": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": [
              "string",
              "null"
            ]
          },
          "issueType": {
            "type": "string",
            "enum": [
              "delivery",
              "billing",
              "review"
            ]
          }
        },
        "required": [
          "orderId",
          "issueType"
        ],
        "additionalProperties": false
      }
    }
  }
}
